      "Read(**/.nuxt/**)",
      "Read(**/.cache/**)",
      "Read(**/coverage/**)",
      "Read(**/venv/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.mypy_cache/**)",
      "Read(**/.ruff_cache/**)",
      "Read(**/.tox/**)",
      "Read(**/.eggs/**)",
      "Read(**/*.egg-info/**)",
      "Read(**/htmlcov/**)",
      "Read(**/.turbo/**)",
      "Read(**/.parcel-cache/**)",
      "Read(**/.svelte-kit/**)",
      "Read(**/.vite/**)",
      "Read(**/.output/**)",
      "Read(**/storybook-static/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
