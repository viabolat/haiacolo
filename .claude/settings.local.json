      "Read(**/*.pyo)",
      "Read(**/*.pyd)",
      "Read(**/.DS_Store)",
      "Read(**/Thumbs.db)",
      "Read(**/*.log)",
      "Read(**/*.zip)",
      "Read(**/*.tar)",
      "Read(**/*.gz)",
      "Read(**/*.pdf)",
      "Read(**/*.mp4)",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_Supabase__*",
      "mcp__claude_ai_Zapier__*"
